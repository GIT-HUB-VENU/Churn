# Server Port Configuration (Render automatically sets $PORT in production)
PORT=8000

# Environment Mode (development / production)
NODE_ENV=production

# Frontend Origin for CORS (optional if deployed together on same origin)
FRONTEND_URL=http://localhost:5173

# Optional: Gemini API Key for AI Executive Summaries & Briefings
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom Dataset File Path (defaults to data/Default_dataset.csv)
DATASET_PATH=data/Default_dataset.csv

# Optional: Configurable Churn Risk Thresholds (defaults: 0.30 and 0.69)
LOW_RISK_THRESHOLD=0.30
HIGH_RISK_THRESHOLD=0.69

# Optional: Frontend API URL (leave blank for relative '/api' on same origin)
# VITE_API_URL=https://your-backend.onrender.com/api
